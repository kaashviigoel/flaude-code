OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/3.0
OPENWEATHER_TIMEOUT_SECONDS=10
OPENWEATHER_MAX_RETRIES=2
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_CACHE_STALE_SECONDS=3600
